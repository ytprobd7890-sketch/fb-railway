# Telegram
TG_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here
TG_CHAT_ID=123456789

# Proxy (comma-separated, optional if auto-fetch on)
PROXIES=
AUTO_FETCH_PROXIES=true
PROXY_VALIDATE_TIMEOUT=8
PROXY_REFRESH_INTERVAL=600

# Account limits
MAX_ACCOUNTS=0
MAX_CONCURRENT=3
DELAY_MIN=5
DELAY_MAX=15
RETRY_ATTEMPTS=3

# Email
EMAIL_TIMEOUT=120
MAIL_TM_RETRY=3

# FB endpoint
FB_BASE=https://m.facebook.com

# HTTP
HTTP_TIMEOUT=30
MAX_REDIRECTS=10

# Captcha
CAPSOLVER_KEY=your_capsolver_api_key_here
